# Copy to .env and fill in. .env is gitignored.

# trading mode: paper, demo or live
FAIRMARK_MODE=paper

DATABASE_URL=postgresql://fairmark:fairmark@localhost:5432/fairmark

# Kalshi demo (demo.kalshi.co)
KALSHI_DEMO_KEY_ID=
KALSHI_DEMO_PRIVATE_KEY_PATH=keys/kalshi_demo.pem

# Kalshi live
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=keys/kalshi_live.pem

ODDS_API_KEY=
ODDSPAPI_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
